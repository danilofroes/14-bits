# Copie para api/.env e preencha. O .env nunca vai para o Git.

# --- obrigatório em produção ---
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- banco ---
# Vazio = SQLite local (api/instance/14bits.db), bom para desenvolvimento.
# Em produção, cole aqui a DATABASE_URL que o Railway fornece.
DATABASE_URL=

# --- ambiente ---
AMBIENTE=desenvolvimento

# --- de onde o front pode falar com a API (separado por vírgula) ---
ORIGENS_PERMITIDAS=http://localhost:5173,http://127.0.0.1:5173

# --- cookie de sessão ---
# Com a API num subdomínio do site (api.14bits.com.br falando com
# 14bits.com.br), "Lax" basta e é a opção mais segura.
# Se o front ficar em outro domínio (ex.: Cloudflare Pages), são necessários
# COOKIE_SAMESITE=None e COOKIE_SEGURO=1 — e aí HTTPS é obrigatório.
COOKIE_SEGURO=0
COOKIE_SAMESITE=Lax
COOKIE_DOMINIO=
